# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud -> App settings -> Secrets.
# Without this, the app uses a local SQLite file (data is lost when Streamlit Cloud restarts).
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: if set, creating the first admin needs this code, so nobody else can claim an empty deployment.
# ADMIN_SETUP_CODE = "choose-a-code"
